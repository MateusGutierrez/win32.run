# Copy to .env and fill in. Never commit .env.
# In production (PM2), set these in the process environment.

# Steam: key from https://steamcommunity.com/dev/apikey
# STEAM_ID accepts a SteamID64 (17 digits) or the custom name from steamcommunity.com/id/<name>
# Profile and "Game details" must be public in Steam privacy settings.
STEAM_API_KEY=
STEAM_ID=

# Spotify: app from https://developer.spotify.com/dashboard
# Redirect URI to register in the app: http://127.0.0.1:8888/callback
# Then run `node scripts/spotify-auth.mjs` to get the refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Optional: a playlist you own, shown in the "My Music" window (ID or open.spotify.com URL)
SPOTIFY_PLAYLIST_ID=
